#!name=ShadowLocPro
#!desc=Apple修改定位；地图选点自动保存到代理工具本地持久化存储，WLOC 脚本直接读取。
#!author=Mr.Eric
#!homepage=https://t.me/Mr_Alex
#!system=ios

[Script]
ShadowLocSaveLocation = type=http-request,pattern=^https:\/\/shadowloc\.ericvip\.workers\.dev\/api\/save-location,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/jasonniceo/loon/refs/heads/main/ShadowLocPro/ShadowLocSaveLocation.js
ShadowLocStatus = type=http-request,pattern=^https:\/\/shadowloc\.ericvip\.workers\.dev\/api\/location-status,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/jasonniceo/loon/refs/heads/main/ShadowLocPro/ShadowLocStatus.js
ShadowLocClear = type=http-request,pattern=^https:\/\/shadowloc\.ericvip\.workers\.dev\/api\/clear-location,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/jasonniceo/loon/refs/heads/main/ShadowLocPro/ShadowLocClear.js
ShadowLocPro = type=http-response,pattern=^https:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc,requires-body=true,binary-body-mode=true,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/jasonniceo/loon/refs/heads/main/ShadowLocPro/ShadowLocPro.js

[MITM]
hostname = %APPEND% shadowloc.ericvip.workers.dev, gs-loc.apple.com, gs-loc-cn.apple.com
