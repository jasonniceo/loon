DOMAIN-SUFFIX,backpack.exchange


# ==================================================
# Backpack Wallet / Mobile App / Browser Extension
# ==================================================

# Backpack 当前钱包及统一 Crypto App 主域
#
# 自动覆盖：
#
# backpack.app
# www.backpack.app
#
# Wallet
# Mobile App
# Browser Extension
